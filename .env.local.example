# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is listed in .gitignore.

# Base URL for the backend API reachable from the browser.
# The /api/v1 prefix must be included.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Secret used server-side to verify Supabase JWT signatures in isAuthenticated().
# Must match the JWT secret from your Supabase project settings.
SUPABASE_JWT_SECRET=tu-supabase-jwt-secret
